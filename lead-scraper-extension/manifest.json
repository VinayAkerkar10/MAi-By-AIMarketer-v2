{
  "manifest_version": 3,
  "name": "Lead Scraper Extension",
  "version": "1.0.0",
  "description": "Extract lead data from any webpage and send it to the MAi Lead Scraper app.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lead Scraper Extension"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
