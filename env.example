# MAi by AIMarketer - Environment Configuration
# Created by Mrityunjay Pandey, AIMarketer Pvt. Ltd.
# Copy this file to .env and fill in your actual values

# Application Settings
APP_NAME=MAi by AIMarketer
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=postgresql://mai_user:mai_password@postgres:5432/mai_db
MONGODB_URI=mongodb://localhost:27017/mai_templates
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Strategy Provider Configuration
# Options: 'ollama' (local), 'openai' (API), or 'auto' (auto-detect)
STRATEGY_PROVIDER=ollama

# Ollama Configuration (Local Deployment)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_STRATEGY_MODEL=llama2
OLLAMA_TIMEOUT=120

# OpenAI Configuration (API)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_BASE_URL=https://api.openai.com/v1

# Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here
SMTP_SERVER=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key-here

# Social Media API Keys
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token

LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Lead Generation / Data Enrichment APIs
CLEARBIT_API_KEY=your-clearbit-api-key
HUNTER_IO_API_KEY=your-hunter-io-api-key
FULLCONTACT_API_KEY=your-fullcontact-api-key
OUTSCRAPER_API_KEY=your-outscraper-api-key

# Google Maps API (if using official API instead of scraping)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn-url
GOOGLE_ANALYTICS_ID=your-google-analytics-id

# File Storage (for uploads and exports)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=mai-aimarketer-files
AWS_REGION=us-east-1

# Security Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# Development Settings
LOG_LEVEL=INFO
ENABLE_DOCS=True
ENABLE_REDOC=True

# Production Settings (set these for production deployment)
# DEBUG=False
# DATABASE_URL=your-production-database-url
# CORS_ORIGINS=["https://yourdomain.com"]
# ALLOWED_HOSTS=["yourdomain.com", "api.yourdomain.com"]